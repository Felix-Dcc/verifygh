# ---------------------------------------------------------------------------
# VerifyGH backend environment
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev

# -- core -------------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json (use json in production)

# -- database ---------------------------------------------------------------
# Leave blank in development to use SQLite. REQUIRED in production.
# postgres://user:password@host:5432/verifygh
# Supabase: use the "Session pooler" URI from Connect (see docs/DEPLOYMENT.md).
DATABASE_URL=
# session (default: direct connection or session pooler) | transaction (a
# transaction pooler such as Supabase's port 6543 - prod refuses 6543 without it)
DB_POOL_MODE=session
DB_SSLMODE=prefer
# Production requires require / verify-ca / verify-full. ALLOW_UNENCRYPTED_DATABASE=true
# overrides that, for a private network link only.
ALLOW_UNENCRYPTED_DATABASE=false

# -- redis / celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=true   # true in dev runs tasks inline, no worker needed

# -- proxies ----------------------------------------------------------------
# Reverse proxies in front of Django that append to X-Forwarded-For. The client
# IP is read that many hops from the RIGHT. 0 = ignore the header entirely.
# Render / most PaaS load balancers: 1. Wrong values make rate limits bypassable.
TRUSTED_PROXY_COUNT=0

# -- frontend / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# -- auth cookies -----------------------------------------------------------
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
AUTH_COOKIE_SECURE=false        # MUST be true in production
AUTH_COOKIE_SAMESITE=Lax        # None when frontend and API are on different sites
AUTH_COOKIE_DOMAIN=
# REQUIRED in production, and different from SECRET_KEY.
JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# PROVIDER SELECTION
# Both default to "mock", which runs the entire product with no credentials
# and no real money. Switch only when you have the real thing.
# ---------------------------------------------------------------------------
VERIFICATION_PROVIDER=mock      # mock | textverified
# Production refuses VERIFICATION_PROVIDER=mock (it would sell simulated
# numbers). Until an authorised provider is configured, use textverified: its
# endpoints are blank, so the catalogue stays empty and nothing is sold.
# Only set this for a non-public staging stack running prod settings.
ALLOW_MOCK_VERIFICATION_IN_PRODUCTION=false
PAYMENT_PROVIDER=mock           # mock | paystack
# Extra providers whose webhook endpoint stays live - only during a provider
# switchover. Never 'mock' in production (prod settings refuse to boot).
WEBHOOK_PROVIDERS=
EXCHANGE_RATE_PROVIDER=manual   # manual | api
# Verification codes and SMS text are erased from finished orders after this.
VERIFICATION_DATA_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Referral programme
# ---------------------------------------------------------------------------
# These seed the ReferralProgram row the first time it is read. After that the
# database is the source of truth, so a super admin can change the bonus in the
# admin console without a deploy. Changing them later does NOT move an existing
# row - see docs/REFERRALS.md.
REFERRAL_PROGRAM_ENABLED=true
REFERRAL_SIGNUP_BONUS_GHS=5.00
REFERRAL_MAX_MONTHLY_SUCCESSFUL_REFERRALS=20
# Requires a verified phone before a referral qualifies. Off by default: there
# is no phone-verification flow yet, so turning it on holds every referral.
REFERRAL_REQUIRE_PHONE_VERIFICATION=false

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: verification provider credentials
# Requires an account or reseller arrangement that permits reselling, plus the
# official API documentation. See docs/PROVIDER_INTEGRATION.md.
# ---------------------------------------------------------------------------
TEXTVERIFIED_API_KEY=
TEXTVERIFIED_API_USERNAME=
TEXTVERIFIED_BASE_URL=

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: MoMo aggregator credentials
# Also register the webhook URL in the provider dashboard:
#   https://<your-api-domain>/api/v1/payments/webhooks/paystack/
# See docs/PAYMENT_INTEGRATION.md.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
# Production refuses sk_test_ keys (they credit real wallets for free payments)
# unless this is set - for a non-public staging stack only.
ALLOW_PAYSTACK_TEST_KEYS=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Used to sign mock webhooks in development so the real verification path runs.
MOCK_PAYMENT_SECRET=mock-webhook-secret

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: exchange rate feed (or keep EXCHANGE_RATE_PROVIDER=manual)
# ---------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: transactional email
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=VerifyGH <no-reply@verifygh.example>

# -- limits and anti-abuse --------------------------------------------------
MIN_DEPOSIT=5.00
MAX_DEPOSIT=2000.00
MAX_WALLET_BALANCE=10000.00
MAX_ACTIVE_ORDERS=5
MAX_ORDERS_PER_DAY=25
MAX_DAILY_SPEND=1500.00
MAX_FAILED_LOGINS=8
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION_FOR_PURCHASE=true
PROVIDER_RATE_LIMIT_PER_MINUTE=120

# Set to false if your provider agreement does not permit relaying message
# bodies or codes to the end user.
DISPLAY_VERIFICATION_CODES=true

# -- order lifecycle --------------------------------------------------------
ORDER_TTL_MINUTES=20
ORDER_POLL_SECONDS=5
PAYMENT_TTL_MINUTES=15
CURRENT_TERMS_VERSION=2026-01-01
