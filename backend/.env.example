# ---------------------------------------------------------------------------
# VerifyGH backend environment
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev

# -- core -------------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json (use json in production)

# -- database ---------------------------------------------------------------
# Leave blank in development to use SQLite. REQUIRED in production.
# postgres://user:password@host:5432/verifygh
DATABASE_URL=
# session (default: a direct connection or a session pooler) | transaction
# (a transaction pooler such as PgBouncer, conventionally on port 6543 -
# production refuses that port without this set)
DB_POOL_MODE=session
DB_SSLMODE=prefer
# Production requires require / verify-ca / verify-full. ALLOW_UNENCRYPTED_DATABASE=true
# overrides that, for a private network link only.
ALLOW_UNENCRYPTED_DATABASE=false

# -- redis / celery ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=true   # true in dev runs tasks inline, no worker needed

# -- proxies ----------------------------------------------------------------
# Reverse proxies in front of Django that append to X-Forwarded-For. The client
# IP is read that many hops from the RIGHT. 0 = ignore the header entirely.
# Render / most PaaS load balancers: 1. Wrong values make rate limits bypassable.
TRUSTED_PROXY_COUNT=0

# -- frontend / CORS --------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# -- auth cookies -----------------------------------------------------------
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
AUTH_COOKIE_SECURE=false        # MUST be true in production
AUTH_COOKIE_SAMESITE=Lax        # None when frontend and API are on different sites
AUTH_COOKIE_DOMAIN=
# REQUIRED in production, and different from SECRET_KEY.
JWT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# PROVIDER SELECTION
# Both default to "mock", which runs the entire product with no credentials
# and no real money. Switch only when you have the real thing.
# ---------------------------------------------------------------------------
VERIFICATION_PROVIDER=mock      # mock | textverified | onlinesim (legacy)
# Production refuses VERIFICATION_PROVIDER=mock (it would sell simulated
# numbers) and refuses a real provider whose credentials are missing. There is
# no fallback. See docs/PROVIDERS.md.
# Only set this for a non-public staging stack running prod settings.
ALLOW_MOCK_VERIFICATION_IN_PRODUCTION=false
PAYMENT_PROVIDER=mock           # mock | paystack
# Extra providers whose webhook endpoint stays live - only during a provider
# switchover. Never 'mock' in production (prod settings refuse to boot).
WEBHOOK_PROVIDERS=
EXCHANGE_RATE_PROVIDER=manual   # manual | api
# Verification codes and SMS text are erased from finished orders after this.
VERIFICATION_DATA_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Referral programme
# ---------------------------------------------------------------------------
# These seed the ReferralProgram row the first time it is read. After that the
# database is the source of truth, so a super admin can change the bonus in the
# admin console without a deploy. Changing them later does NOT move an existing
# row - see docs/REFERRALS.md.
REFERRAL_PROGRAM_ENABLED=true
REFERRAL_SIGNUP_BONUS_GHS=5.00
REFERRAL_MAX_MONTHLY_SUCCESSFUL_REFERRALS=20
# Requires a verified phone before a referral qualifies. Off by default: there
# is no phone-verification flow yet, so turning it on holds every referral.
REFERRAL_REQUIRE_PHONE_VERIFICATION=false

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: verification provider credentials
# Requires an account or reseller arrangement that permits reselling, plus the
# official API documentation. See docs/PROVIDER_INTEGRATION.md.
# ---------------------------------------------------------------------------
# -- TextVerified (the primary provider) ------------------------------------
# The account email and the API key from the TextVerified dashboard. The key
# can spend our credit, so it is a secret: dashboard only, never committed,
# never logged, never sent to the frontend. Having credentials is not
# permission to resell: see docs/PROVIDERS.md.
TEXTVERIFIED_API_USERNAME=
TEXTVERIFIED_API_KEY=
# Leave empty to use the documented host (https://www.textverified.com).
TEXTVERIFIED_BASE_URL=
# Optional: the whsec_ secret from TextVerified's API Webhook Settings, for
# signed v2.sms.received callbacks. Without it we poll only.
TEXTVERIFIED_WEBHOOK_SECRET=

# -- Cloudflare edge (docs/CLOUDFLARE.md) -----------------------------------
# off | report | enforce. Stay "off" until the DNS is on Cloudflare and its
# Transform Rule sets X-VerifyGH-Origin to CLOUDFLARE_ORIGIN_SECRET.
CLOUDFLARE_MODE=off
# 32+ random characters. Secret: Railway and Cloudflare only, never committed.
CLOUDFLARE_ORIGIN_SECRET=

# -- Cloudflare Turnstile (sign-in and sign-up) -------------------------------
# The widget's SECRET key. Empty: no check. Locally you can use Cloudflare's
# published always-pass test secret, 1x0000000000000000000000000000000AA, with
# the matching test site key in the frontend.
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames a token may be solved on. Empty: not checked.
TURNSTILE_ALLOWED_HOSTNAMES=

# -- Official brand logos (docs/SERVICE_LOGOS.md) ----------------------------
# Brandfetch client ID (developers.brandfetch.com). Empty: Admin > Logos
# explains how to set it and searches nothing.
BRANDFETCH_CLIENT_ID=

# -- Sign in with Google (docs/GOOGLE_SIGN_IN.md) ----------------------------
# A "Web application" OAuth client. Both empty: no Google button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match an authorised redirect URI on that client exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# -- OnlineSim (legacy; no longer the active provider) ----------------------
ONLINESIM_API_KEY=
# Leave empty to use the documented host (https://onlinesim.io).
ONLINESIM_BASE_URL=
# Tariffs come back in the OnlineSim profile's own currency. Set this to match
# that profile, or the exchange rate is applied to the wrong unit.
ONLINESIM_CURRENCY=USD

# How many provider services to price per catalogue sync (the service list and
# the price are separate upstream calls, so this bounds the sync).
PROVIDER_CATALOG_LIMIT=60
# The most we accept paying above the price we just quoted, sent as maxPrice
# when reserving a number. 1.05 = 5% headroom.
PROVIDER_PRICE_TOLERANCE=1.05

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: MoMo aggregator credentials
# Also register the webhook URL in the provider dashboard:
#   https://<your-api-domain>/api/v1/payments/webhooks/paystack/
# See docs/PAYMENT_INTEGRATION.md.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=

# -- Hubtel (adapter structure only; endpoints pending official docs) -------
# Production refuses to boot with PAYMENT_PROVIDER=hubtel until the adapter is
# filled in from Hubtel's API reference - see apps/payments/hubtel.py.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
HUBTEL_BASE_URL=
# Production refuses sk_test_ keys (they credit real wallets for free payments)
# unless this is set - for a non-public staging stack only.
ALLOW_PAYSTACK_TEST_KEYS=false
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Used to sign mock webhooks in development so the real verification path runs.
MOCK_PAYMENT_SECRET=mock-webhook-secret

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: exchange rate feed (or keep EXCHANGE_RATE_PROVIDER=manual)
# ---------------------------------------------------------------------------
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=

# ---------------------------------------------------------------------------
# YOU MUST SUPPLY: transactional email
# ---------------------------------------------------------------------------
# Resend (https://resend.com/django). Setting RESEND_API_KEY alone is enough:
# the app then configures Resend's documented SMTP endpoint itself. Leave it
# empty for local development and email is printed to the console instead.
#
# Production refuses to boot without a delivering backend, because verification
# email gates every purchase - see docs/EMAIL.md.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, or Resend rejects the
# send. Reserved TLDs (.example, .invalid, .test) are refused outright.
DEFAULT_FROM_EMAIL=VerifyGH <no-reply@verifygh.com>

# Only needed for a mail provider that is not Resend. With RESEND_API_KEY set
# and EMAIL_BACKEND empty, these are all filled in automatically.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds before a silent mail server is given up on.
EMAIL_TIMEOUT=10

# -- limits and anti-abuse --------------------------------------------------
MIN_DEPOSIT=10.00
MAX_DEPOSIT=2000.00
MAX_WALLET_BALANCE=10000.00
MAX_ACTIVE_ORDERS=5
MAX_ORDERS_PER_DAY=25
MAX_DAILY_SPEND=1500.00
MAX_FAILED_LOGINS=8
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION_FOR_PURCHASE=true
# Refuse Mobile Money top-ups while nothing is purchasable. Taking a deposit
# into an empty marketplace leaves money that cannot be spent or withdrawn.
# Set false only on a staging stack that exercises deposits deliberately.
REQUIRE_CATALOG_FOR_DEPOSIT=true
# Orders in flight across the whole platform, kept below the supplier's ceiling
# on numbers held at once (OnlineSim's standard limit is 40). 0 disables.
MAX_PLATFORM_ACTIVE_ORDERS=32
# How long a verification link stays valid.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2
PROVIDER_RATE_LIMIT_PER_MINUTE=120

# Set to false if your provider agreement does not permit relaying message
# bodies or codes to the end user.
DISPLAY_VERIFICATION_CODES=true

# -- order lifecycle --------------------------------------------------------
ORDER_TTL_MINUTES=20
ORDER_POLL_SECONDS=5
PAYMENT_TTL_MINUTES=15
CURRENT_TERMS_VERSION=2026-01-01
