# The VerifyGH API. No secret ever belongs in this file: everything here is
# compiled into the browser bundle and is public.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_BRAND_NAME=VerifyGH

# Cloudflare Turnstile site key (public by design). Empty: no widget. When set,
# sign-in and sign-up show it and the Content-Security-Policy allows
# https://challenges.cloudflare.com. Cloudflare's always-pass test key for local
# work is 1x00000000000000000000AA (pair it with the test secret on the API).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare origin lock, read server-side by middleware only (docs/CLOUDFLARE.md).
CLOUDFLARE_MODE=off
CLOUDFLARE_ORIGIN_SECRET=
